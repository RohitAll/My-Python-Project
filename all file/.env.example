# JARVIS Assistant Environment Configuration

# AI Provider Configuration
# Supported providers: gemini, openai, groq, offline
DEFAULT_AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

GCP_API_KEY=your_gcp_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Voice System Settings
ENABLE_VOICE=true
STT_PROVIDER=google
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-ChristopherNeural
WAKE_WORD_ENABLED=true
WAKE_WORD=hey jarvis
ENABLE_VOICE=true
STT_PROVIDER=google
TTS_PROVIDER=pyttsx3
WAKE_WORD_ENABLED=false

# Security & Confirmation Settings
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
AUTO_APPROVE_LOW_RISK=true

# System Settings
LOG_LEVEL=INFO
DATABASE_PATH=jarvis.db
APP_THEME=futuristic_dark
